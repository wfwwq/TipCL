<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TipCL.Core</RootNamespace>
    <AssemblyName>TipCL.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!--
    资源与 Windows 版 TipCL.csproj 用同一组 LogicalName 嵌入到 TipCL.Core 程序集,
    因为 CoreResources 读的是自己所在程序集(见 GOAL §3「内嵌资源」)。
    这些文件(.json/.mjs/.js/.d.ts)会被 SDK 的默认 None glob 收走,
    显式摘掉 None 以免同一个文件同时是 None 项与 EmbeddedResource 项。
  -->
  <ItemGroup>
    <None Remove="Resources\**\*" />
  </ItemGroup>

  <!--
    A4:`Ai\TomlLite.cs` 是 internal(A4 之前全仓库只有被排除的 `Ai\Conflict.cs` 用它),
    而 A4 的验收要求给 TOML 解析写用例。开 InternalsVisibleTo 给测试程序集,
    比用反射测内部类型更直接,也不改任何被复制的文件(见 DECISIONS.md D-19)。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="TipCL.Tests" />
  </ItemGroup>

  <!--
    A2 起一共 19 个文件被 Compile Remove(A2/A3 的 7 个 + A4 的 12 个),A5 把它们全部恢复编译:
    BackendApi / Plugins / BridgeServer 三者之间的循环依赖在 A5 一次性闭合,恢复后 TipCL.Core
    里**没有任何被排除编译的文件**。A2-A4 的推导见 DECISIONS.md D-11 / D-13 / D-14 / D-18。
  -->
  <ItemGroup>
    <!--
      裁决(Lead,A5):`Plugins\SecretStore.cs` 166/172 行用 ProtectedData(DPAPI)。
      net8.0 不内置该 API(它在 Windows Desktop 的共享框架里,类库用不了),
      所以按 Lead 裁决直接引这个 NuGet 包让 SecretStore.cs 原样编译。
      非 Windows 分支(AES-GCM + Keychain)归 B1;该包在 mac 上调用会抛 PlatformNotSupportedException,
      记入 PROGRESS.md 的 A5「运行时差异清点」。见 DECISIONS.md D-22。
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      B1a:`IImageCodec` 的 mac 实现(SkiaImageCodec / SkiaDecodedImage),WebP 也走 Skia,不引 ImageSharp。
      版本必须与 Avalonia 解析到的 SkiaSharp 一致 → 放在 Directory.Build.props 的 TipCLSkiaSharpVersion。
    -->
    <PackageReference Include="SkiaSharp" Version="$(TipCLSkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\locales\en.json" LogicalName="TipCL.Core.locales.en.json" />
    <EmbeddedResource Include="Resources\locales\zh_CN.json" LogicalName="TipCL.Core.locales.zh_CN.json" />
    <EmbeddedResource Include="Resources\ai\model_rules.json" LogicalName="TipCL.Core.ai.model_rules.json" />
    <EmbeddedResource Include="Resources\plugin-host\**\*" LogicalName="TipCL.Core.plugin-host.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
