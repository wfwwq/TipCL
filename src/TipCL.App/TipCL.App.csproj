<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TipCL</AssemblyName>
    <RootNamespace>TipCL</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Avalonia 11 的 native interop(Windows/Win32 后端)需要 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TipCL.Core\TipCL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(TipCLAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(TipCLAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(TipCLAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(TipCLAvaloniaVersion)" />
    <!-- smoke 离屏截图用:Headless 平台 + Skia 真实渲染 -->
    <PackageReference Include="Avalonia.Headless" Version="$(TipCLAvaloniaVersion)" />
  </ItemGroup>

  <!-- C1a:内置图标字体(替代系统 Segoe MDL2 / Fluent Icons)。Windows 版是 WPF 的 <Resource>,
       Avalonia 对应的是 AvaloniaResource,运行期用 avares://TipCL/Resources/fonts/TipCLIcons.ttf#TipCL Icons 取。
       .axaml 文件不用在这里列:Avalonia 的 build props 默认把 **\*.axaml 收进 AvaloniaXaml。 -->
  <ItemGroup>
    <AvaloniaResource Include="Resources\fonts\TipCLIcons.ttf" />
  </ItemGroup>

  <!-- C2c2:内置预设背景(设置 → 壁纸 → 预设背景;Windows 侧是 WPF 的 <Resource Include="Resources\wallpapers\*.jpg">)。
       任务书说这些"已经内嵌在 Core 的 Resources\wallpapers 里",实测 **Core 里没有**(Core 只嵌了
       locales / ai / plugin-host),所以按 Windows 的做法嵌进 App。 -->
  <ItemGroup>
    <AvaloniaResource Include="Resources\wallpapers\*.jpg" />
  </ItemGroup>

  <!-- C2c2:加载器官方图标(Windows 侧只在 -p:Premium=true 时嵌入;GOAL 定了 mac 等同 premium,所以恒嵌)。
       forge_gh.png 实为 JPEG 内容,解码按文件内容识别,扩展名不影响(与 Windows csproj 的注释同)。 -->
  <ItemGroup>
    <AvaloniaResource Include="PremiumAssets\grass.png" />
    <AvaloniaResource Include="PremiumAssets\fabric_gh.png" />
    <AvaloniaResource Include="PremiumAssets\forge_gh.png" />
    <AvaloniaResource Include="PremiumAssets\neoforge_gh.png" />
    <AvaloniaResource Include="PremiumAssets\quilt_gh.png" />
  </ItemGroup>

  <!-- C1a:色板与图标系统的用例要看 internal 的 Palette / LucideAssets(与 D-19 同一手法)。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="TipCL.Tests" />
  </ItemGroup>

</Project>
