<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:TipCL.App.Shell"
        x:Class="TipCL.App.Shell.MainWindow"
        Title="TipCL"
        Width="1180" Height="740" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        SystemDecorations="Full"
        Background="{DynamicResource Shell.PageBg}"
        FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, WenQuanYi Micro Hei, sans-serif">
  <!-- M1-A3 窗口外壳：40px 自定义标题栏 + 196px 分组导航 + 右侧占位页。 -->
  <!-- Shell.* 令牌转发到 A2 主题键，故 Palette 必须与 ShellTokens 成对合并 -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TipCL.App/Themes/Palette.Light.axaml" />
        <ResourceInclude Source="avares://TipCL.App/Shell/ShellTokens.Light.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid RowDefinitions="40,*">
    <shell:TitleBar x:Name="TitleBarHost" Grid.Row="0" />
    <Grid Grid.Row="1" ColumnDefinitions="196,*">
      <shell:SideNav x:Name="NavHost" Grid.Column="0" />
      <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
  </Grid>
</Window>
