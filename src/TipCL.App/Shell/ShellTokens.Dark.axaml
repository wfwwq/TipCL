<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- M1-A3 外壳令牌（深色）：全部转发到 A2 主题键（Themes/Palette.Dark.axaml）。
       Shell.* 别名仅供外壳内部引用，收敛点在这里；需与 Palette 字典一起合并（见 MainWindow）。 -->
  <StaticResource x:Key="Shell.PageBg" ResourceKey="B.Canvas" />
  <StaticResource x:Key="Shell.TitleBarBg" ResourceKey="B.Chrome" />
  <StaticResource x:Key="Shell.TitleBarLine" ResourceKey="B.TitleBarLine" />
  <StaticResource x:Key="Shell.Ink" ResourceKey="B.Ink" />
  <StaticResource x:Key="Shell.InkMuted" ResourceKey="B.InkMuted" />
  <StaticResource x:Key="Shell.CardBg" ResourceKey="B.Card" />
  <StaticResource x:Key="Shell.CardBorder" ResourceKey="B.CardBorder" />
  <StaticResource x:Key="Shell.NavHover" ResourceKey="B.Hover" />
  <StaticResource x:Key="Shell.Accent" ResourceKey="B.Accent" />
  <StaticResource x:Key="Shell.OnAccent" ResourceKey="B.OnAccent" />
  <StaticResource x:Key="Shell.CaptionFg" ResourceKey="B.CaptionInk" />
  <StaticResource x:Key="Shell.CaptionHoverBg" ResourceKey="B.Hover" />
  <StaticResource x:Key="Shell.CaptionCloseHoverBg" ResourceKey="B.CaptionHot" />
  <StaticResource x:Key="Shell.CaptionCloseHoverFg" ResourceKey="B.OnCaptionHot" />
  <StaticResource x:Key="Shell.Sep" ResourceKey="B.TitleSep" />
  <Color x:Key="Shell.AccentColor">#3FB07C</Color>
</ResourceDictionary>
