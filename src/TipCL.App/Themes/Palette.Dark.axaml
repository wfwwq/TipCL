<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TipCL Linux 设计令牌 · 深色。键名与 Windows 版 src/TipCL/Themes/Palette.Dark.xaml 一一对应，色值照抄。 -->
  <Color x:Key="C.Accent">#3FB07C</Color>
  <Color x:Key="C.AccentStrong">#267A56</Color>
  <Color x:Key="C.AccentText">#79C8A3</Color>
  <Color x:Key="C.AccentDeep">#79C8A3</Color>
  <Color x:Key="C.AccentLite">#5FCB98</Color>
  <Color x:Key="C.Canvas">#161616</Color>
  <Color x:Key="C.Paper">#1E1E1E</Color>
  <SolidColorBrush x:Key="B.Accent" Color="#3FB07C" />
  <SolidColorBrush x:Key="B.AccentStrong" Color="#267A56" />
  <SolidColorBrush x:Key="B.OnAccentStrong" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.AccentText" Color="#79C8A3" />
  <SolidColorBrush x:Key="B.AccentTint" Color="#1C2420" />
  <SolidColorBrush x:Key="B.AccentDeep" Color="#79C8A3" />
  <SolidColorBrush x:Key="B.AccentLite" Color="#5FCB98" />
  <SolidColorBrush x:Key="B.AccentSoft" Color="#1B3A2C" />
  <SolidColorBrush x:Key="B.AccentSoft2" Color="#204636" />
  <SolidColorBrush x:Key="B.AccentBorder" Color="#2A5B45" />
  <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.Canvas" Color="#161616" />
  <SolidColorBrush x:Key="B.Paper" Color="#1E1E1E" />
  <SolidColorBrush x:Key="B.Paper2" Color="#242424" />
  <SolidColorBrush x:Key="B.Side" Color="#1A1A1A" />
  <SolidColorBrush x:Key="B.Chrome" Color="#1A1A1A" />
  <SolidColorBrush x:Key="B.Line" Color="#333333" />
  <SolidColorBrush x:Key="B.LineSoft" Color="#282828" />
  <SolidColorBrush x:Key="B.Hover" Color="#2A2A2A" />
  <SolidColorBrush x:Key="B.Ink" Color="#EDEDED" />
  <SolidColorBrush x:Key="B.InkSoft" Color="#C0C0C0" />
  <SolidColorBrush x:Key="B.InkMuted" Color="#9A9A9A" />
  <SolidColorBrush x:Key="B.InkFaint" Color="#8A8A8A" />
  <SolidColorBrush x:Key="B.Danger" Color="#E8615F" />
  <SolidColorBrush x:Key="B.DangerSoft" Color="#3A2321" />
  <SolidColorBrush x:Key="B.Warn" Color="#E5A73C" />
  <SolidColorBrush x:Key="B.WarnSoft" Color="#3A2F1C" />
  <SolidColorBrush x:Key="B.Info" Color="#5A9CE8" />
  <SolidColorBrush x:Key="B.InfoSoft" Color="#1E2A3A" />
  <SolidColorBrush x:Key="B.Ok" Color="#3FB07C" />
  <SolidColorBrush x:Key="B.OnOk" Color="#000000" />
  <SolidColorBrush x:Key="B.Scroll" Color="#3F3F3F" />
  <SolidColorBrush x:Key="B.ScrollHover" Color="#555555" />
  <SolidColorBrush x:Key="B.Mask" Color="#000000" Opacity="0.54" />
  <SolidColorBrush x:Key="B.Glass" Color="#1C2420" Opacity="0.72" />
  <SolidColorBrush x:Key="B.GlassStrong" Color="#202824" Opacity="0.86" />
  <SolidColorBrush x:Key="B.GlassBorder" Color="#536B5E" Opacity="0.62" />
  <LinearGradientBrush x:Key="B.BannerFill" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#2A855E" Offset="0" />
    <GradientStop Color="#267A56" Offset="0.52" />
    <GradientStop Color="#1D6043" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="B.OnBanner" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="B.LogoFill" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#2A855E" Offset="0" />
    <GradientStop Color="#1D6043" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="B.OnLogo" Color="#FFFFFF" />
  <!-- WP-A v2 token（2026-11-06）：卡片 / 标题栏 / 窗口按钮 / 灰按钮 / 分段控件 / 行分隔 -->
  <SolidColorBrush x:Key="B.Card" Color="#232323" />
  <SolidColorBrush x:Key="B.CardBorder" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="B.TitleBar" Color="#1C1C1C" Opacity="0.92" />
  <SolidColorBrush x:Key="B.TitleBarLine" Color="#FFFFFF" Opacity="0.07" />
  <SolidColorBrush x:Key="B.TitleSep" Color="#FFFFFF" Opacity="0.14" />
  <SolidColorBrush x:Key="B.CaptionInk" Color="#C8C8C8" />
  <SolidColorBrush x:Key="B.CaptionHot" Color="#C42B1C" />
  <SolidColorBrush x:Key="B.OnCaptionHot" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.SegRail" Color="#FFFFFF" Opacity="0.06" />
  <SolidColorBrush x:Key="B.SegOn" Color="#2E2E2E" />
  <SolidColorBrush x:Key="B.RowLine" Color="#2C2C2C" />
  <SolidColorBrush x:Key="B.RowHover" Color="#282828" />
  <LinearGradientBrush x:Key="B.PageWash" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#161616" Offset="0" />
    <GradientStop Color="#1B1B1B" Offset="0.6" />
    <GradientStop Color="#181818" Offset="1" />
  </LinearGradientBrush>
  <!-- Fluent 滑块取色覆盖(同 Palette.Light,深色档) -->
  <SolidColorBrush x:Key="SliderTrackFill" Color="#282828" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3FB07C" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3FB07C" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3FB07C" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#3FB07C" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#3FB07C" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#3FB07C" />
  <!-- R35 lin-l0 · 布局 v3 编辑态令牌(2026-11-20)。与 Palette.Light.axaml 成对;效果图只画了浅色,深色取值与 Windows r34/l0
       Palette.Dark.xaml 同值(按本色板的卡片 / 分段层级推导)。…OnDark / B.EditGlass* / B.OnEditGlass* / B.EditDim 与浅色相同
       (它们只用在永远是深色的启动页英雄图上)。B.WarnSoft 沿用上方已有的键。键表与用法见 docs/layout-v3-tokens.md。 -->
  <SolidColorBrush x:Key="B.EditOutline" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="B.EditOutlineHover" Color="#5CFFFFFF" />
  <SolidColorBrush x:Key="B.EditOutlineOnDark" Color="#59FFFFFF" />
  <SolidColorBrush x:Key="B.EditOutlineHoverOnDark" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="B.EditDropFill" Color="#1B3A2C" />
  <SolidColorBrush x:Key="B.EditDropFillOnDark" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="B.EditColShade" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="B.EditColShadeOnDark" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="B.EditBarBg" Color="#2B2B2B" />
  <SolidColorBrush x:Key="B.EditBarLine" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="B.EditItemBg" Color="#313131" />
  <SolidColorBrush x:Key="B.EditSegRail" Color="#1E1E1E" />
  <SolidColorBrush x:Key="B.EditSegOn" Color="#3A3A3A" />
  <SolidColorBrush x:Key="B.EditDim" Color="#800A0E16" />
  <SolidColorBrush x:Key="B.EditGlass" Color="#B80E121B" />
  <SolidColorBrush x:Key="B.EditGlassLine" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="B.EditGlassChip" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="B.EditGlassChipLine" Color="#38FFFFFF" />
  <SolidColorBrush x:Key="B.OnEditGlass" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.OnEditGlassMuted" Color="#A8FFFFFF" />
  <SolidColorBrush x:Key="B.WarnInk" Color="#EBB45E" />
  <!-- 阴影:与浅色同形,深色底上加重不透明度(同 Windows Fx.* 深色档) -->
  <BoxShadows x:Key="Fx.EditBar">0 2 10 0 #59000000</BoxShadows>
  <BoxShadows x:Key="Fx.EditLabel">0 2 8 0 #66000000</BoxShadows>
  <BoxShadows x:Key="Fx.Drawer">-12 0 32 0 #80000000</BoxShadows>
  <BoxShadows x:Key="Fx.SegOn">0 1 2 0 #4D000000</BoxShadows>
  <BoxShadows x:Key="Fx.ResizeGrip">0 1 4 0 #80000000</BoxShadows>
</ResourceDictionary>
