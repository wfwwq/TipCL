<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TipCL Linux 设计令牌 · 浅色。键名与 Windows 版 src/TipCL/Themes/Palette.Light.xaml 一一对应，色值照抄。 -->
  <Color x:Key="C.Accent">#2E9B6B</Color>
  <Color x:Key="C.AccentStrong">#1F7A52</Color>
  <Color x:Key="C.AccentText">#1F7A52</Color>
  <Color x:Key="C.AccentDeep">#1F7A52</Color>
  <Color x:Key="C.AccentLite">#4FBE8B</Color>
  <Color x:Key="C.Canvas">#F5F5F5</Color>
  <Color x:Key="C.Paper">#FFFFFF</Color>
  <SolidColorBrush x:Key="B.Accent" Color="#2E9B6B" />
  <SolidColorBrush x:Key="B.AccentStrong" Color="#1F7A52" />
  <SolidColorBrush x:Key="B.OnAccentStrong" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.AccentText" Color="#1F7A52" />
  <SolidColorBrush x:Key="B.AccentTint" Color="#F3F9F6" />
  <SolidColorBrush x:Key="B.AccentDeep" Color="#1F7A52" />
  <SolidColorBrush x:Key="B.AccentLite" Color="#4FBE8B" />
  <SolidColorBrush x:Key="B.AccentSoft" Color="#E7F5EE" />
  <SolidColorBrush x:Key="B.AccentSoft2" Color="#D7EEE2" />
  <SolidColorBrush x:Key="B.AccentBorder" Color="#BFE3D2" />
  <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.Canvas" Color="#F5F5F5" />
  <SolidColorBrush x:Key="B.Paper" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.Paper2" Color="#FAFAFA" />
  <SolidColorBrush x:Key="B.Side" Color="#FAFAFA" />
  <SolidColorBrush x:Key="B.Chrome" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.Line" Color="#E6E6E6" />
  <SolidColorBrush x:Key="B.LineSoft" Color="#F0F0F0" />
  <SolidColorBrush x:Key="B.Hover" Color="#F2F2F2" />
  <SolidColorBrush x:Key="B.Ink" Color="#262626" />
  <SolidColorBrush x:Key="B.InkSoft" Color="#565656" />
  <SolidColorBrush x:Key="B.InkMuted" Color="#666666" />
  <SolidColorBrush x:Key="B.InkFaint" Color="#6B6B6B" />
  <SolidColorBrush x:Key="B.Danger" Color="#D64545" />
  <SolidColorBrush x:Key="B.DangerSoft" Color="#FCEBEA" />
  <SolidColorBrush x:Key="B.Warn" Color="#D68A17" />
  <SolidColorBrush x:Key="B.WarnSoft" Color="#FDF3E2" />
  <SolidColorBrush x:Key="B.Info" Color="#2F72C4" />
  <SolidColorBrush x:Key="B.InfoSoft" Color="#EAF2FC" />
  <SolidColorBrush x:Key="B.Ok" Color="#2E9B6B" />
  <SolidColorBrush x:Key="B.OnOk" Color="#000000" />
  <SolidColorBrush x:Key="B.Scroll" Color="#CFCFCF" />
  <SolidColorBrush x:Key="B.ScrollHover" Color="#B0B0B0" />
  <SolidColorBrush x:Key="B.Mask" Color="#1A1A1A" Opacity="0.34" />
  <SolidColorBrush x:Key="B.Glass" Color="#F3F9F6" Opacity="0.76" />
  <SolidColorBrush x:Key="B.GlassStrong" Color="#F8FBF9" Opacity="0.88" />
  <SolidColorBrush x:Key="B.GlassBorder" Color="#BFDCCF" Opacity="0.68" />
  <LinearGradientBrush x:Key="B.BannerFill" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#237F59" Offset="0" />
    <GradientStop Color="#1F7A52" Offset="0.52" />
    <GradientStop Color="#185F40" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="B.OnBanner" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="B.LogoFill" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#25835C" Offset="0" />
    <GradientStop Color="#195F42" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="B.OnLogo" Color="#FFFFFF" />
  <!-- WP-A v2 token（2026-11-06）：卡片 / 标题栏 / 窗口按钮 / 灰按钮 / 分段控件 / 行分隔 -->
  <SolidColorBrush x:Key="B.Card" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.CardBorder" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="B.TitleBar" Color="#FFFFFF" Opacity="0.92" />
  <SolidColorBrush x:Key="B.TitleBarLine" Color="#000000" Opacity="0.06" />
  <SolidColorBrush x:Key="B.TitleSep" Color="#000000" Opacity="0.10" />
  <SolidColorBrush x:Key="B.CaptionInk" Color="#555555" />
  <SolidColorBrush x:Key="B.CaptionHot" Color="#C42B1C" />
  <SolidColorBrush x:Key="B.OnCaptionHot" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.SegRail" Color="#000000" Opacity="0.05" />
  <SolidColorBrush x:Key="B.SegOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="B.RowLine" Color="#F2F2F2" />
  <SolidColorBrush x:Key="B.RowHover" Color="#FAFAFA" />
  <LinearGradientBrush x:Key="B.PageWash" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#EDEDED" Offset="0" />
    <GradientStop Color="#F7F7F7" Offset="0.6" />
    <GradientStop Color="#F3F3F3" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
