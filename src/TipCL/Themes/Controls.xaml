                        </BeginStoryboard>
                      </TriggerBase.EnterActions>
                      <TriggerBase.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArR" Storyboard.TargetProperty="Angle" To="0" Duration="{StaticResource D.Fast}" />
