<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- 内置图标字体（基于 Fluent UI System Icons, MIT），码位与 Segoe MDL2 Assets 一致；不再依赖系统字体，Win7/8.1/精简系统也能正常显示 -->
  <FontFamily x:Key="F.Icon">pack://application:,,,/TipCL;component/Resources/fonts/#TipCL Icons, Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="F.Ui">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>
  <system:Double x:Key="R.Card" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
  <CornerRadius x:Key="CR.Card">12</CornerRadius>
  <CornerRadius x:Key="CR.Ctl">8</CornerRadius>
  <CornerRadius x:Key="CR.Pill">999</CornerRadius>
  <Duration x:Key="D.Fast">0:0:0.13</Duration>
  <Duration x:Key="D.Med">0:0:0.22</Duration>
  <CubicEase x:Key="E.Out" EasingMode="EaseOut" />
  <QuadraticEase x:Key="E.InOut" EasingMode="EaseInOut" />
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="T.H1" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.H2" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.H3" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.Muted" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="T.Small" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkFaint}" />
  </Style>
  <Style x:Key="T.Mono" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
  </Style>
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource B.Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource CR.Card}" />
    <Setter Property="Border.Padding" Value="16" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="CardFlat" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{DynamicResource B.Paper2}" />
    <Setter Property="Border.Padding" Value="12" />
  </Style>
  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="R" Background="{DynamicResource B.Scroll}" CornerRadius="4" Margin="3,2" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="R" Value="{DynamicResource B.ScrollHover}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="R" Value="{DynamicResource B.ScrollHover}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="#00FFFFFF">
                <Track Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="BtnTpl" TargetType="{x:Type ButtonBase}">
    <Grid Name="Root" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
      </UIElement.RenderTransform>
      <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True" CornerRadius="{StaticResource CR.Ctl}" />
      <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" CornerRadius="{StaticResource CR.Ctl}" />
      <ContentPresenter Name="Cp" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontFamily="{TemplateBinding Control.FontFamily}" TextElement.FontSize="{TemplateBinding Control.FontSize}" TextElement.FontWeight="{TemplateBinding Control.FontWeight}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Ov" Storyboard.TargetProperty="Opacity" To="0.07" Duration="{StaticResource D.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Ov" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource D.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Ov" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.06" />
              <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.972" Duration="0:0:0.08" />
              <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.972" Duration="0:0:0.08" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource D.Med}" EasingFunction="{StaticResource E.Out}" />
              <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource D.Med}" EasingFunction="{StaticResource E.Out}" />
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Btn.Base" TargetType="{x:Type ButtonBase}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource BtnTpl}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Btn.Primary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccentStrong}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Btn.Soft" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentSoft2}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style x:Key="Btn.Normal" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="Btn.Ghost" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
  </Style>
  <Style x:Key="Btn.Danger" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
  </Style>
  <Style x:Key="Btn.Icon" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Ghost}">
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Btn.Chip" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.Paper2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Btn.OnBanner" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.OnBanner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.OnBanner}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type Label}" TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type Expander}" TargetType="{x:Type Expander}" BasedOn="{StaticResource {x:Type Expander}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}" BasedOn="{StaticResource {x:Type GroupBox}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="Btn.Caption" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
    <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="#00FFFFFF">
            <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" CornerRadius="6" Margin="2" />
            <TextBlock Text="{TemplateBinding ContentControl.Content}" FontFamily="{StaticResource F.Icon}" FontSize="{TemplateBinding Control.FontSize}" Foreground="{TemplateBinding Control.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="UIElement.Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ov" Property="UIElement.Opacity" Value="0.15" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.CaptionClose" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="#00FFFFFF">
            <Border Name="Ov" Background="#E81123" Opacity="0" CornerRadius="6" Margin="2" />
            <TextBlock Text="{TemplateBinding ContentControl.Content}" FontFamily="{StaticResource F.Icon}" FontSize="{TemplateBinding Control.FontSize}" Foreground="{TemplateBinding Control.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="UIElement.Opacity" Value="1" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavItem" TargetType="{x:Type ToggleButton}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="36" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Margin="8,1">
            <Border Name="Sel" Background="{DynamicResource B.AccentSoft}" CornerRadius="8" Opacity="0" />
            <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" CornerRadius="8" />
            <Border Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="1,0,0,0" Background="{DynamicResource B.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="BarSc" ScaleY="0.2" />
              </UIElement.RenderTransform>
            </Border>
            <ContentPresenter Name="Cp" Margin="14,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Ov" Property="UIElement.Opacity" Value="0.05" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Value="{DynamicResource B.AccentText}" Property="Foreground" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="BarSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource D.Med}" EasingFunction="{StaticResource E.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource D.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="BarSc" Storyboard.TargetProperty="ScaleY" To="0.2" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TabItemBtn" TargetType="{x:Type ToggleButton}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkMuted}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Background="#00FFFFFF">
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="Un" Height="2.5" CornerRadius="2" VerticalAlignment="Bottom" Background="{DynamicResource B.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5" Margin="6,0">
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="UnSc" ScaleX="0.3" />
              </UIElement.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource B.Ink}" Property="Foreground" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Value="{DynamicResource B.AccentText}" Property="Foreground" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Un" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="UnSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource D.Med}" EasingFunction="{StaticResource E.Out}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Un" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09" />
                    <DoubleAnimation Storyboard.TargetName="UnSc" Storyboard.TargetProperty="ScaleX" To="0.3" Duration="0:0:0.09" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Input" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource B.Accent}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource B.Accent}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Border Name="Bd" Background="{DynamicResource B.Paper}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" SnapsToDevicePixels="True" CornerRadius="{StaticResource CR.Ctl}" />
            <Border Name="Fx" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1.4" Opacity="0" CornerRadius="{StaticResource CR.Ctl}" />
            <TextBlock Name="Ph" Foreground="{DynamicResource B.InkFaint}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource B.ScrollHover}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Fx" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource D.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Fx" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource D.Fast}" />
                  </Storyboard>
