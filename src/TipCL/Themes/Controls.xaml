            <TextBox Name="PART_EditableTextBox" Visibility="Collapsed" Margin="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource B.Ink}" CaretBrush="{DynamicResource B.Accent}" FontFamily="{StaticResource F.Ui}" FocusVisualStyle="{x:Null}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type TextBox}">
                  <ScrollViewer Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                </ControlTemplate>
              </Control.Template>
            </TextBox>
            <TextBlock Name="Ph" Text="{TemplateBinding FrameworkElement.Tag}" Foreground="{DynamicResource B.InkFaint}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" PopupAnimation="Fade" Focusable="False">
