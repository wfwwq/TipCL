          <ControlTemplate.Triggers>
            <Trigger Property="ProgressBar.IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="UIElement.Opacity" Value="0.35" />
              <Setter TargetName="Glow" Property="UIElement.Opacity" Value="1" />
