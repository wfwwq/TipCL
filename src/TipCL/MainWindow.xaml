<Window x:Class="TipCL.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TipCL" Width="900" Height="550" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" AllowDrop="True" Background="#00FFFFFF" xmlns:tipcl="clr-namespace:TipCL">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Name="RootBorder" Background="#00FFFFFF" BorderBrush="{DynamicResource B.GlassBorder}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Name="ContentLayer" Row="0" RowSpan="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Name="WallHost" Row="0" RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" />
        <Border Name="TopBar" Grid.Row="0" Background="{DynamicResource B.TitleBar}" BorderBrush="{DynamicResource B.TitleBarLine}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,20,0">
              <Grid Name="BridgePill" Background="#00FFFFFF" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource B.LogoFill}">
                  <TextBlock Text="T" Foreground="{DynamicResource B.OnLogo}" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Ellipse Name="BridgeDot" Width="8" Height="8" Margin="0,-3,-3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource B.Danger}" Stroke="{DynamicResource B.Paper}" StrokeThickness="1.5" Visibility="Collapsed" />
              </Grid>
              <TextBlock Text="TipCL" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="TopTabPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <ToggleButton Name="TabLaunch" Style="{StaticResource Tab.Top}" Content="启动" />
              <ToggleButton Name="TabLibrary" Style="{StaticResource Tab.Top}" Content="实例库" />
              <ToggleButton Name="TabTasks" Style="{StaticResource Tab.Top}" Content="下载" />
              <ToggleButton Name="TabPlugins" Style="{StaticResource Tab.Top}" Content="插件" />
              <ToggleButton Name="TabSettings" Style="{StaticResource Tab.Top}" Content="设置" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button Name="AiBtn" Style="{StaticResource Btn.TitleChip}" Height="26" Padding="0" VerticalAlignment="Center" Margin="0,0,2,0" IsTabStop="True">
                <Grid>
                  <Border CornerRadius="13" Background="{DynamicResource B.GlassStrong}" BorderBrush="{DynamicResource B.GlassBorder}" BorderThickness="1" />
                  <StackPanel Orientation="Horizontal" Margin="8,0,9,0">
                    <Path Style="{StaticResource Ico.Line}" Data="M8,1.5 V4.5 M8,11.5 V14.5 M1.5,8 H4.5 M11.5,8 H14.5 M3.4,3.4 L5.4,5.4 M10.6,10.6 L12.6,12.6 M3.4,12.6 L5.4,10.6 M10.6,5.4 L12.6,3.4" />
                    <TextBlock Text="AI" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Name="ThemeBtn" Style="{StaticResource Btn.TitleIcon}" VerticalAlignment="Center" IsTabStop="True">
                <Path Name="ThemeIco" Style="{StaticResource Ico.Line}" />
              </Button>
              <Button Name="AccBtn" Style="{StaticResource Btn.TitleChip}" VerticalAlignment="Center" Margin="2,0,2,0" IsTabStop="True">
                <StackPanel Orientation="Horizontal">
                  <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource B.AccentStrong}">
                    <TextBlock Name="AccInitial" Foreground="{DynamicResource B.OnAccentStrong}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Name="AccName" FontSize="12.5" FontWeight="Medium" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
              </Button>
              <Rectangle Width="1" Height="16" Margin="6,0" Fill="{DynamicResource B.TitleSep}" />
              <Button Name="MinBtn" Style="{StaticResource Btn.Caption}">
                <Path Style="{StaticResource Ico.Caption}" Data="M0.5,5 H9.5" />
              </Button>
              <Button Name="MaxBtn" Style="{StaticResource Btn.Caption}">
                <Path Name="MaxIco" Style="{StaticResource Ico.Caption}" />
              </Button>
              <Button Name="CloseBtn" Style="{StaticResource Btn.CaptionClose}" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Row="1">
          <Rectangle Name="PageWash" Fill="{DynamicResource B.PageWash}" />
          <ContentControl Name="PageHost" Focusable="False" />
          <Border Name="DockHost" VerticalAlignment="Bottom" Margin="16,0,16,14" Visibility="Collapsed" />
        </Grid>
        <Canvas Name="FlyHost" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Border Name="DropVeil" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource B.Mask}" Margin="0">
          <Border CornerRadius="10" Padding="20,16,20,18" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource B.GlassStrong}" BorderBrush="{DynamicResource B.GlassBorder}">
            <StackPanel>
              <TextBlock Text="" FontFamily="{StaticResource F.Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource B.Accent}" />
              <TextBlock Name="DropVeilTitle" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
              <TextBlock Name="DropVeilHint" FontSize="12" Margin="0,3,0,0" MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource B.InkMuted}" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
      <StackPanel Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" />
      <Grid Name="DialogHost" Row="0" RowSpan="2" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
