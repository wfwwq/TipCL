{
  // AI4-download:下载页 + 安装页的小剧本(改 → 截图 → 对比 循环用;full.json 里的同名截图状态一致)。
  //   v3-download-normal = layout_v3 A 常态(900x580);download / install = v2 download2 / install2(900x550)。
  //   install-1.20.1 走假加载器源(VisualTourNet:只对 1.20.1 假答 Fabric / Forge / NeoForge / Quilt 元数据),
  //   install-offline 用 26.3(没有假答 ⇒ 加载器列表拿不到 ⇒ 显示「获取失败 · 重试」)。
  "width": 900, "height": 550, "theme": "light", "fixture": true, "settleMs": 350,
  "steps": [
    { "op": "wait", "ms": 1500 },
    { "op": "resize", "width": 900, "height": 580 },
    { "op": "navigate", "page": "download" },
    { "op": "click", "text": "原版" },
    { "op": "wait", "ms": 500 },
    { "op": "shot", "name": "v3-download-normal" },
    { "op": "rightclick", "text": "26.3" },
    { "op": "shot", "name": "download-rightclick" },
    { "op": "close" },
    { "op": "resize", "width": 900, "height": 550 },
    { "op": "hover", "text": "1.21.10" },
    { "op": "shot", "name": "download-hover" },
    { "op": "click", "text": "快照" },
    { "op": "wait", "ms": 300 },
    { "op": "shot", "name": "download-snapshot" },
    { "op": "click", "text": "远古" },
    { "op": "wait", "ms": 300 },
    { "op": "shot", "name": "download-old" },
    { "op": "click", "text": "正式版" },
    { "op": "wait", "ms": 300 },
    { "op": "shot", "name": "download" },
    { "op": "type", "into": { "text": "搜索版本" }, "text": "1.20.1" },
    { "op": "wait", "ms": 500 },
    { "op": "shot", "name": "download-search" },
    { "op": "click", "type": "Button", "text": "安装" },
    { "op": "wait", "ms": 1200 },
    { "op": "shot", "name": "install-vanilla" },
    { "op": "click", "text": "Fabric" },
    { "op": "wait", "ms": 400 },
    { "op": "shot", "name": "install" },
    { "op": "dump", "name": "install" },
    { "op": "click", "text": "Forge" },
    { "op": "wait", "ms": 300 },
    { "op": "shot", "name": "install-forge" },
    { "op": "theme", "value": "dark" },
    { "op": "click", "text": "Fabric" },
    { "op": "shot", "name": "dark-install" },
    { "op": "theme", "value": "light" },
    { "op": "click", "tip": "返回" },
    { "op": "click", "type": "TextBox", "within": "PageHost" },
    { "op": "key", "keys": "Ctrl+A" },
    { "op": "type", "into": { "type": "TextBox", "within": "PageHost" }, "text": "26.3" },
    { "op": "wait", "ms": 400 },
    { "op": "click", "type": "Button", "text": "安装" },
    { "op": "wait", "ms": 1200 },
    { "op": "shot", "name": "install-offline" },
    { "op": "click", "tip": "返回" },
    { "op": "click", "type": "TextBox", "within": "PageHost" },
    { "op": "key", "keys": "Ctrl+A" },
    { "op": "key", "keys": "Back" },
    { "op": "expect", "text": "26.3" },
    { "op": "click", "text": "Mod" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-mod" },
    { "op": "click", "text": "整合包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-modpack" },
    { "op": "click", "text": "数据包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-datapack" },
    { "op": "click", "text": "资源包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-respack" },
    { "op": "click", "text": "光影" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-shader" },
    { "op": "click", "text": "世界" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-world" },
    { "op": "click", "text": "原版" },
    { "op": "theme", "value": "dark" },
    { "op": "shot", "name": "dark-download" },
    { "op": "click", "text": "Mod" }, { "op": "wait", "ms": 500 }, { "op": "shot", "name": "dark-download-mod" },
    { "op": "click", "text": "原版" },
    { "op": "theme", "value": "light" },
    { "op": "resize", "width": 780, "height": 550 },
    { "op": "shot", "name": "narrow-download" },
    { "op": "click", "text": "Mod" }, { "op": "wait", "ms": 500 }, { "op": "shot", "name": "narrow-download-mod" },
    { "op": "click", "text": "原版" },
    { "op": "resize", "width": 900, "height": 550 },
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "通用" },
    { "op": "scroll", "top": true },
    { "op": "click", "tip": "绯红" },
    { "op": "navigate", "page": "download" },
    { "op": "shot", "name": "red-download" },
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "通用" },
    { "op": "scroll", "top": true },
    { "op": "click", "tip": "松绿" },
    { "op": "reset" }
  ]
}
