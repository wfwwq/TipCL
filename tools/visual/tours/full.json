{
  // 完整巡检剧本(AI3-visual)。三段:
  //   A/B/C = 让实际界面停在 v3 效果图的同一个状态(尺寸与效果图窗口一致:启动页 1000x600 / 780x600,
  //           下载页 900x580,设置 → 布局 900x660);
  //   D     = v2 效果图 / Windows 实拍图对应的状态(900x550 = 外壳默认尺寸);
  //   E     = 覆盖:全部页面、下载分段、设置子页、对话框、弹出层、深色主题、窄窗口。
  // 带 note 的 FAIL 是「效果图里有、实际没有」的入口(找不到即证据),在 findings.md 里逐条对应。
  "width": 900, "height": 550, "theme": "light", "fixture": true, "settleMs": 350,
  "steps": [
    { "op": "wait", "ms": 1500 },

    // ================= A. 启动页 v3(宽 1000 / 窄 780) =================
    { "op": "resize", "width": 1000, "height": 600 },
    { "op": "navigate", "page": "launch" },
    { "op": "click", "tip": "启动配置", "note": "在「启动配置」浮层的「版本」下拉里选效果图里的 Fabric 1.20.1(实例切换浮层里点版本 = 直接启动,巡检不走那条路)" },
    { "op": "click", "type": "ComboBox", "index": 1 },
    { "op": "click", "text": "fabric-loader-0.15.11-1.20.1" },
    { "op": "close" },
    { "op": "expect", "text": "启动配置", "absent": true, "note": "配置浮层应已关闭" },
    { "op": "shot", "name": "v3-launch-normal-1000" },
    { "op": "expect", "text": "编辑组件", "note": "launch_v3:右下角「编辑组件」入口(finding #2)" },
    { "op": "rightclick", "contains": "就绪", "note": "退而求其次:右键空白处找「自定义布局...」" },
    { "op": "shot", "name": "launch-rightclick-1000" },
    { "op": "click", "text": "自定义布局...", "note": "启动页有没有可编辑的组件区(finding #1/#2)" },
    { "op": "shot", "name": "v3-launch-edit-1000" },
    { "op": "click", "text": "添加组件", "note": "launch_v3:编辑条「添加组件」→ 组件库抽屉" },
    { "op": "shot", "name": "v3-launch-lib-1000" },
    { "op": "key", "keys": "Ctrl+Z", "note": "launch_v3:编辑态 Ctrl+Z 撤销" },
    { "op": "reset" },
    { "op": "resize", "width": 780, "height": 600 },
    { "op": "shot", "name": "v3-launch-normal-780" },
    { "op": "rightclick", "contains": "就绪" },
    { "op": "click", "text": "自定义布局..." },
    { "op": "shot", "name": "v3-launch-edit-780" },
    { "op": "click", "text": "添加组件" },
    { "op": "shot", "name": "v3-launch-lib-780" },
    { "op": "reset" },

    // ================= B. 下载页 v3(900x580):常态 → 右键「自定义布局...」→ 编辑态 =================
    { "op": "resize", "width": 900, "height": 580 },
    { "op": "navigate", "page": "download" },
    { "op": "click", "text": "原版" },
    { "op": "wait", "ms": 500 },
    { "op": "shot", "name": "v3-download-normal" },
    { "op": "rightclick", "text": "26.3" },
    { "op": "shot", "name": "download-rightclick" },
    { "op": "click", "text": "自定义布局..." },
    { "op": "wait", "ms": 400 },
    { "op": "shot", "name": "v3-download-edit" },
    { "op": "dump", "name": "v3-download-edit" },
    { "op": "key", "keys": "Ctrl+Z" },
    { "op": "click", "text": "添加", "note": "layout_v3:编辑条「添加」→ 添加抽屉(隐藏的内容 + 组件)" },
    { "op": "shot", "name": "v3-download-edit-add" },
    { "op": "click", "text": "完成编辑" },
    { "op": "expect", "text": "完成编辑", "absent": true },
    // 主题色换成红色再看一次编辑态(layout_v3 的主题色切换)
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "通用" },
    { "op": "click", "tip": "绯红" },
    { "op": "navigate", "page": "download" },
    { "op": "rightclick", "text": "26.3" },
    { "op": "click", "text": "自定义布局..." },
    { "op": "shot", "name": "v3-download-edit-red" },
    { "op": "click", "text": "完成编辑" },

    // ================= C. 设置 → 布局 v3(900x660):顶部 / 页面 / 方案 / 高级 =================
    { "op": "resize", "width": 900, "height": 660 },
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "布局" },
    { "op": "wait", "ms": 500 },
    { "op": "scroll", "top": true },
    { "op": "shot", "name": "v3-settings-layout-red" },
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "通用" },
    { "op": "click", "tip": "松绿" },
    { "op": "click", "text": "布局" },
    { "op": "scroll", "top": true },
    { "op": "shot", "name": "v3-settings-layout-top" },
    { "op": "dump", "name": "v3-settings-layout-top" },
    { "op": "scroll", "to": { "text": "页面区块" } },
    { "op": "shot", "name": "v3-settings-layout-pages" },
    { "op": "scroll", "to": { "text": "布局方案" } },
    { "op": "shot", "name": "v3-settings-layout-schemes" },
    { "op": "expect", "text": "高级", "note": "layout_v3:「高级」分组(分栏、网页与按钮组件、布局文件)" },
    { "op": "scroll", "screens": 10 },
    { "op": "shot", "name": "v3-settings-layout-adv" },
    { "op": "reset" },

    // ================= D. v2 效果图 / Windows 实拍图对应状态(900x550) =================
    { "op": "resize", "width": 900, "height": 550 },
    { "op": "navigate", "page": "launch" },
    { "op": "shot", "name": "launch" },
    { "op": "click", "text": ".minecraft" },
    { "op": "shot", "name": "launch-switch" },
    { "op": "key", "keys": "Esc" },
    { "op": "close", "note": "Esc 没关掉时再显式关一次" },
    { "op": "theme", "value": "dark" },
    { "op": "shot", "name": "launch-dark" },
    { "op": "click", "text": ".minecraft" },
    { "op": "shot", "name": "launch-switch-dark" },
    { "op": "close" },
    { "op": "theme", "value": "light" },
    { "op": "navigate", "page": "library" },
    { "op": "wait", "ms": 600 },
    { "op": "shot", "name": "library" },
    { "op": "navigate", "page": "download" },
    { "op": "click", "text": "原版" },
    { "op": "shot", "name": "download" },
    { "op": "type", "into": { "text": "搜索版本" }, "text": "1.20.1" },
    { "op": "wait", "ms": 500 },
    { "op": "shot", "name": "download-search" },
    { "op": "click", "type": "Button", "text": "安装" },
    { "op": "wait", "ms": 800 },
    { "op": "shot", "name": "install" },
    { "op": "dump", "name": "install" },
    { "op": "click", "type": "Button", "within": "PageHost", "index": 0, "note": "安装页左上角返回钮:没有文字也没有提示,只能按位置顺序找" },
    { "op": "navigate", "page": "plugins" },
    { "op": "wait", "ms": 500 },
    { "op": "shot", "name": "plugins" },
    { "op": "click", "text": "市场" },
    { "op": "wait", "ms": 800 },
    { "op": "shot", "name": "plugins-market" },
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "通用" },
    { "op": "scroll", "top": true },
    { "op": "shot", "name": "settings-general" },

    // ================= E. 覆盖巡检 =================
    // 下载页各分段(Modrinth 走假源;世界 = CurseForge,离线落空态)
    { "op": "navigate", "page": "download" },
    { "op": "click", "text": "Mod" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-mod" },
    { "op": "click", "text": "整合包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-modpack" },
    { "op": "click", "text": "数据包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-datapack" },
    { "op": "click", "text": "资源包" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-respack" },
    { "op": "click", "text": "光影" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-shader" },
    { "op": "click", "text": "世界" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "download-world" },
    { "op": "click", "text": "原版" },
    { "op": "click", "text": "任务" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "tasks" },

    // 设置子页
    { "op": "navigate", "page": "settings" },
    { "op": "click", "text": "账号" }, { "op": "shot", "name": "settings-account" },
    { "op": "click", "text": "Java" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "settings-java" },
    { "op": "click", "text": "下载与网络" }, { "op": "shot", "name": "settings-network" },
    { "op": "click", "text": "服务器" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "settings-servers" },
    { "op": "click", "text": "游戏时长" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "settings-playtime" },
    { "op": "click", "text": "反馈与关于" }, { "op": "shot", "name": "settings-about" },
    { "op": "click", "text": "布局" }, { "op": "scroll", "top": true }, { "op": "shot", "name": "settings-layout" },

    // 其它页面
    { "op": "click", "name": "AiBtn" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "ai" },
    { "op": "click", "name": "AccBtn" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "account" },
    { "op": "navigate", "page": "instance" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "version-manage" },
    { "op": "navigate", "page": "multiplayer" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "multiplayer" },

    // 对话框:实例详情 / 版本设置 / 存档 / 管理模组 / 新建实例 / 导入
    { "op": "navigate", "page": "library" },
    { "op": "click", "text": "实例详情" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "dlg-instance-detail" },
    { "op": "click", "tip": "返回" },
    { "op": "click", "tip": "版本设置" }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "dlg-version-setup" },
    { "op": "close" },
    { "op": "click", "text": "新建实例" }, { "op": "shot", "name": "dlg-new-instance" },
    { "op": "close" },
    { "op": "click", "text": "导入整合包", "note": "无头平台没有系统文件选择框:只看点下去会不会出错" }, { "op": "shot", "name": "dlg-import-pack" },
    { "op": "click", "tip": "实例操作" }, { "op": "shot", "name": "library-instance-menu" },
    { "op": "close" },
    { "op": "navigate", "page": "instance" },
    { "op": "rightclick", "text": "fabric-loader-0.15.11-1.20.1" }, { "op": "shot", "name": "version-menu" },
    { "op": "click", "text": "存档管理..." }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "dlg-saves" },
    { "op": "close" },
    { "op": "click", "tip": "实例操作" },
    { "op": "click", "text": "管理模组" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "dlg-mods" },
    { "op": "close" },

    // 弹出层:实例切换 / 启动配置(含「更多设置」)/ 新闻
    { "op": "navigate", "page": "launch" },
    { "op": "click", "tip": "启动配置" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "pop-config" },
    { "op": "click", "text": "更多设置" }, { "op": "shot", "name": "pop-config-more" },
    { "op": "close" },
    { "op": "click", "contains": "Snapshot 7" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "pop-news" },
    { "op": "close" },

    // 深色主题
    { "op": "theme", "value": "dark" },
    { "op": "navigate", "page": "library" }, { "op": "shot", "name": "dark-library" },
    { "op": "navigate", "page": "download" }, { "op": "click", "text": "原版" }, { "op": "shot", "name": "dark-download" },
    { "op": "navigate", "page": "settings" }, { "op": "click", "text": "通用" }, { "op": "scroll", "top": true }, { "op": "shot", "name": "dark-settings" },
    { "op": "navigate", "page": "plugins" }, { "op": "shot", "name": "dark-plugins" },
    { "op": "click", "name": "AiBtn" }, { "op": "shot", "name": "dark-ai" },
    { "op": "navigate", "page": "library" }, { "op": "click", "tip": "版本设置" }, { "op": "shot", "name": "dark-dlg-version-setup" },
    { "op": "close" },
    { "op": "theme", "value": "light" },

    // 窄窗口(780)
    { "op": "resize", "width": 780, "height": 550 },
    { "op": "navigate", "page": "library" }, { "op": "shot", "name": "narrow-library" },
    { "op": "navigate", "page": "download" }, { "op": "shot", "name": "narrow-download" },
    { "op": "navigate", "page": "settings" }, { "op": "click", "text": "布局" }, { "op": "scroll", "top": true }, { "op": "shot", "name": "narrow-settings-layout" },
    { "op": "reset" }
  ]
}
