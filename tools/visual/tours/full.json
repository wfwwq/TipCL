    { "op": "click", "tip": "实例操作" }, { "op": "shot", "name": "library-instance-menu" },
    { "op": "close" },
    { "op": "navigate", "page": "instance" },
    { "op": "rightclick", "text": "fabric-loader-0.15.11-1.20.1" }, { "op": "shot", "name": "version-menu" },
    { "op": "click", "text": "存档管理..." }, { "op": "wait", "ms": 600 }, { "op": "shot", "name": "dlg-saves" },
    { "op": "close" },
    { "op": "click", "tip": "实例操作" },
    { "op": "click", "text": "管理模组" }, { "op": "wait", "ms": 800 }, { "op": "shot", "name": "dlg-mods" },
