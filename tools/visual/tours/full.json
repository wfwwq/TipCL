    { "op": "click", "tip": "启动配置" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "pop-config" },
    { "op": "click", "text": "更多设置" }, { "op": "shot", "name": "pop-config-more" },
    { "op": "close" },
    { "op": "click", "contains": "Snapshot 7" }, { "op": "wait", "ms": 400 }, { "op": "shot", "name": "pop-news" },
    { "op": "close" },

