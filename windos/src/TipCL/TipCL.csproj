<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <!-- annotations：允许 `string?` 等可空注解（消除 CS8632），但不启用可空警告分析（避免引入海量 CS86xx） -->
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TipCL</AssemblyName>
    <RootNamespace>TipCL</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>TipCL.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>1.1.0</Version>
    <Product>TipCL 启动器</Product>
    <AssemblyTitle>TipCL 启动器</AssemblyTitle>
    <Company>TipCL</Company>
    <!-- 反编译还原的代码会有大量风格类警告，这里不当成错误 -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0649;CS0414;CS8981</NoWarn>

    <!-- 双版本交付（交接必读 §2.5 / DECISIONS D-6）：
         dotnet build TipCL.sln -c Release               → compact（体积红线版，行为与基线一致）
         dotnet build TipCL.sln -c Release -p:Premium=true → premium（嵌入官方图标/hero，不受体积限制） -->
    <DefineConstants Condition="'$(Premium)'=='true'">$(DefineConstants);PREMIUM</DefineConstants>
    <!-- 只开启动页标题栏沉浸（LaunchPage SyncImmersive），其余保持 compact 行为：dotnet build -c Release -p:Immersive=true -->
    <DefineConstants Condition="'$(Immersive)'=='true'">$(DefineConstants);IMMERSIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- 插件凭据：DPAPI（ProtectedData） -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Win7/8.1 的 WIC 不支持 WebP：用纯托管解码兜底（2.x 为 Apache-2.0，支持 .NET Framework）。
         不升级 3.2.0+：该版本起仅 target net6.0+，net48 无法消费（Win7/8.1 兼容是硬约束）。
         下列 5 条审计告警经逐条核实均为**不可达路径**（详见 docs/security/imagesharp-audit.md 与 DECISIONS D-20）：
         本仓库唯一 ImageSharp 入口是 WebpFallback.ToPng 的 Image.Load(WebpOnly, data)，
         WebpOnly 只注册 WebpConfigurationModule——TIFF 解码/编码、ICC Entries 解析、HistogramEqualization
         在全仓库零调用（WebpFallbackTests.DecoderRegistersOnlyWebp 作回归守卫）。
         原生替代方案（libwebp/dwebp）会引入 UCRT/VCRUNTIME 依赖或丢 x86，破坏 Win7 承诺，故不采用。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- 把依赖 DLL 打进单个 exe -->
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
    <!-- 插件界面：WebView2（托管 DLL 由 Costura 打进 exe；原生 WebView2Loader.dll 作为内嵌资源，运行时释放，见 Services/WebViewHost.Loader.cs）
         PrivateAssets=all：不向引用本项目的测试工程流动，避免测试输出目录混入 WebView2.Wpf（其 ThemeInfoAttribute 依赖 net48 WPF 程序集）
         NeverCopyLoaderDllToOutputDirectory=true：loader 由我们自己内嵌+释放，不需要包把它作为 Content 拷到输出目录。
         WPF 会把 Content 项生成 [assembly: AssemblyAssociatedContentFile]（属性类型在 PresentationFramework），
         而 xunit 的 VSTest 适配器计算测试 UniqueID 时会枚举 TipCL.exe 的程序集属性，
         net8 测试宿主加载不到 net48 的 PresentationCore/PresentationFramework → 测试全过后运行仍 FATAL -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <!-- ImageSharp 2.1.13 审计豁免：5 条告警全部位于 TIFF/ICC/直方图路径，本程序只注册 WebP 解码器，
       这些路径不可达（逐条分析见 docs/security/imagesharp-audit.md）。升级到修复版 3.2.0 需要 net6.0+，
       与 net48/Win7 硬约束冲突；守卫测试 WebpFallbackTests.DecoderRegistersOnlyWebp 防止未来扩大入口。 -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <PropertyGroup>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <!-- WebView2Loader.dll（x64/x86/arm64）内嵌进 exe，启动 WebView 前按当前进程架构释放到 %TIPCL_HOME%/runtime/webview2/loader/<arch>/ -->
  <ItemGroup Condition="'$(PkgMicrosoft_Web_WebView2)' != ''">
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x64/native/WebView2Loader.dll" LogicalName="TipCL.WebView2Loader.x64.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-x86/native/WebView2Loader.dll" LogicalName="TipCL.WebView2Loader.x86.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)/runtimes/win-arm64/native/WebView2Loader.dll" LogicalName="TipCL.WebView2Loader.arm64.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置图标字体：替代系统 Segoe MDL2 / Fluent Icons -->
    <Resource Include="Resources\fonts\TipCLIcons.ttf" />
    <!-- 内置资源：词表与 AI 模型规则（CoreResources 以 TipCL.Core.<路径> 读取） -->
    <!-- 上面这些源文件先由 tools/pack-core-resources.ps1 确定性 gzip 成同目录 .gz,再内嵌;
         读取侧由 CoreResources.ReadByResourceName 按 gzip 魔数透明解压 → Payload / Python / Node 侧零改动。
         注意:LogicalName 必须与未压缩时逐字相同(CoreResources.ListDir 靠「前缀 + 恰好一个点」枚举,
         把 .gz 后缀带进 LogicalName 会让 ListDir 直接把它过滤掉);
         改了源就必须重跑 pack-core-resources.ps1,否则 tests/TipCL.Tests/CoreResourcesPackTests.cs 会当场红。 -->
    <EmbeddedResource Include="Resources\locales\en.json.gz" LogicalName="TipCL.Core.locales.en.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\locales\zh_CN.json.gz" LogicalName="TipCL.Core.locales.zh_CN.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\ai\model_rules.json.gz" LogicalName="TipCL.Core.ai.model_rules.json" WithCulture="false" />
    <!-- 插件 Node 宿主脚本（node-host 维护；运行时释放到 runtime/plugin-host，见 Core/Plugins/NodeRuntime.cs） -->
    <!-- host.mjs.gz / sdk.js.gz 这类取 %(Filename) 正好去掉 .gz;tipcl-plugin.d.ts.gz 是多点文件名,
         %(Extension) 只取最后一段(.gz)会丢掉 .ts,所以它单独显式写全名。 -->
    <EmbeddedResource Include="Resources\plugin-host\**\*.mjs.gz" LogicalName="TipCL.Core.plugin-host.%(RecursiveDir)%(Filename)" WithCulture="false" />
    <EmbeddedResource Include="Resources\plugin-host\**\*.js.gz" LogicalName="TipCL.Core.plugin-host.%(RecursiveDir)%(Filename)" WithCulture="false" />
    <EmbeddedResource Include="Resources\plugin-host\tipcl-plugin.d.ts.gz" LogicalName="TipCL.Core.plugin-host.tipcl-plugin.d.ts" WithCulture="false" />
    <!-- 内置默认背景（设置 → 壁纸 → 预设背景；点击释放到数据目录 wallpapers/ 再走 ui_background 管线） -->
    <Resource Include="Resources\wallpapers\*.jpg" />
    <!-- 启动页默认背景（无截图时的回退，两版通用；PremiumAssets 组里的同名项已移除避免重复嵌入） -->
    <Resource Include="PremiumAssets\hero.jpg" />
  </ItemGroup>

  <!-- premium 专属嵌入资源（compact 不嵌入，走运行时下载，见 Services/LoaderIcons.cs 与 Pages/LaunchPage.cs）。
       forge_gh.png 实为 JPEG 内容，WIC 解码按文件内容识别，扩展名不影响；素材来自 docs/mockups-hark/v2/，
       quilt 图标为 QuiltMC 官方头像（https://github.com/QuiltMC.png?size=64，64×64）。 -->
  <ItemGroup Condition="'$(Premium)'=='true'">
    <Resource Include="PremiumAssets\grass.png" />
    <Resource Include="PremiumAssets\fabric_gh.png" />
    <Resource Include="PremiumAssets\forge_gh.png" />
    <Resource Include="PremiumAssets\neoforge_gh.png" />
    <Resource Include="PremiumAssets\quilt_gh.png" />
  </ItemGroup>

</Project>
