<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    .NET Framework 会拒绝 Assembly.LoadFrom 一个"看起来来自网络位置"的程序集
    (FileLoadException:"请启用 loadFromRemoteSources 开关")。在受限宿主 / 沙箱 / 映射盘里跑
    本驱动时就会命中,所以这里显式打开。**这只影响驱动进程**;真机正常路径(本地盘、未打 MOTW)
    不需要它 —— 详见 samples\dotnet-block-plugin\README.md 的说明。
  -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
