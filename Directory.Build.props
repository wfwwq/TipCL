<Project>

  <!--
    mac 线三个工程的公共属性(A1 建立)。
    - TFM / LangVersion / Nullable / AllowUnsafeBlocks 按 GOAL.md 第 3 节的技术决定统一。
    - NoWarn 沿用 Windows 版 TipCL.csproj 的列表(见 DECISIONS.md D-10)。
    - 包版本集中在这里,TipCLAvaloniaVersion 用私有前缀,避免和 Avalonia 包自带的
      AvaloniaVersion 属性互相覆盖。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- 与 Windows 版 TipCL.csproj 的 NoWarn 逐项一致(A2),不要在这里加新编号压警告。 -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0649;CS0414;CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A2 抬到 flatcontainer 索引里最高的 11.x 稳定版,取代 D-01 的 11.3.2(见 DECISIONS.md D-10)。 -->
    <TipCLAvaloniaVersion>11.3.23</TipCLAvaloniaVersion>
  </PropertyGroup>

</Project>
