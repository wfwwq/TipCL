<Project>

  <!--
    mac 线三个工程的公共属性(A1 建立)。
    - TFM / LangVersion / Nullable / AllowUnsafeBlocks 按 GOAL.md 第 3 节的技术决定统一。
    - NoWarn 沿用 Windows 版 TipCL.csproj 的列表(见 DECISIONS.md D-10)。
    - 包版本集中在这里,TipCLAvaloniaVersion 用私有前缀,避免和 Avalonia 包自带的
      AvaloniaVersion 属性互相覆盖。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- 与 Windows 版 TipCL.csproj 的 NoWarn 逐项一致(A2),不要在这里加新编号压警告。 -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0649;CS0414;CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A2 抬到 flatcontainer 索引里最高的 11.x 稳定版,取代 D-01 的 11.3.2(见 DECISIONS.md D-10)。 -->
    <TipCLAvaloniaVersion>11.3.23</TipCLAvaloniaVersion>
    <!--
      B1a:`TipCL.Core` 的 Skia 图片编解码用(见 GOAL §3「图片」)。
      **必须与 Avalonia 解析到的 SkiaSharp 版本一致**(Avalonia 11.3.23 → SkiaSharp 2.88.9),
      升级 Avalonia 时一起核对;两个版本不一致时进程里会同时加载两份 SkiaSharp,原生库会冲突。
    -->
    <TipCLSkiaSharpVersion>2.88.9</TipCLSkiaSharpVersion>
  </PropertyGroup>

</Project>
