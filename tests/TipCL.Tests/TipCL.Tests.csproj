    <!-- C1a(2026-11-13):Ported\IconFontTests.cs 已恢复编译 —— 内置图标字体已就位,
         该文件按 A6 的 B 类路径规则改了 3 处(仓库根标记 / 字体路径 / 扫描根),
         断言一字未改;改动逐条记在 PROGRESS.md 的 C1a 小节。 -->
  </ItemGroup>

</Project>
