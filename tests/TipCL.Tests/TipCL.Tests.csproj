<Project Sdk="Microsoft.NET.Sdk">

  <!-- 单元测试：直接引用启动器程序集，只测不依赖界面的逻辑，Windows 和 Linux 都能跑 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1702;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TipCL\TipCL.csproj" SetTargetFramework="TargetFramework=net48" SkipGetTargetFrameworkProperties="true" ReferenceOutputAssembly="true" Private="true" />
  </ItemGroup>

</Project>
