<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TipCL.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Exe 只是为了能 `dotnet exec TipCL.Tests.dll` 跑进程内执行器(本沙箱 dotnet test 不可用,见 DECISIONS.md D-05)。
         VSTest 照旧按测试程序集加载本 dll,不受 OutputType 影响。 -->
    <OutputType>Exe</OutputType>
    <!-- Microsoft.NET.Test.Sdk 默认会生成 AutoGeneratedProgram.cs(自带 Main),会和上面的入口点冲突 -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TipCL.Core\TipCL.Core.csproj" />
  </ItemGroup>

</Project>
