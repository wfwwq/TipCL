<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TipCL.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Exe 只是为了能 `dotnet exec TipCL.Tests.dll` 跑进程内执行器(本沙箱 dotnet test 不可用,见 DECISIONS.md D-05)。
         VSTest 照旧按测试程序集加载本 dll,不受 OutputType 影响。 -->
    <OutputType>Exe</OutputType>
    <!-- Microsoft.NET.Test.Sdk 默认会生成 AutoGeneratedProgram.cs(自带 Main),会和上面的入口点冲突 -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TipCL.Core\TipCL.Core.csproj" />
    <!-- C1a:色板 / 图标字体 / Lucide 图标的用例要看 TipCL.App 的 internal 类型
         (Palette、Lucide、LucideAssets;靠 TipCL.App.csproj 的 InternalsVisibleTo 看到)。
         代价是测试进程里多带一套 Avalonia 程序集:实测无害,而且 C1a 的用例本来就**必须**
         起 headless Avalonia —— Avalonia 的 Geometry.Parse 没有 IPlatformRenderInterface
         会直接抛(见 DECISIONS.md D-68)。 -->
    <ProjectReference Include="..\..\src\TipCL.App\TipCL.App.csproj" />
    <!-- B3:打包工具的全部逻辑都是 internal static 纯函数(靠 TipCL.Packager 的 InternalsVisibleTo 看到),
         这里只引用工程,**不**调它的 Program.Main(测试不许起进程、不许跑 dotnet publish)。 -->
    <ProjectReference Include="..\..\tools\TipCL.Packager\TipCL.Packager.csproj" />
  </ItemGroup>

  <!-- B1a:WebP 真实夹具(从 Windows 测试目录字节级复制,libwebp 官方 test.webp,BSD)。
       Skia 版编解码器的用例要读它,所以必须进输出目录。 -->
  <ItemGroup>
    <None Update="fixtures\webp-sample.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A6:从 Windows tests\TipCL.Tests(除 TestHome.cs)字节级复制来的 29 个测试文件。
        第 1 步先整体 Remove,确认构建/测试不受影响;第 4 步逐个决策后逐个放出来:
        A 类(原样通过)/ B 类(最小适配后通过)→ 已从这个 Remove 里删掉;
        C 类(本包搬不了)→ 留在下面,每个都注明原因与恢复包(详见 PROGRESS.md 的 A6 小节)。 -->
  <ItemGroup>
    <!-- C3a(2026-11-13):Ported\PageLayoutTests.cs 与 Ported\LayoutDefaultTests.cs 已恢复编译 ——
         C3a 把 Pages\PageBlock.cs / PageLayoutStore.cs / DashCard.cs / DashLayout.cs 按 Windows 源
         搬进 src\TipCL.App\Pages 了,这两个文件现在能编。
         PageLayoutTests.cs 按 A6 的 B 类路径规则改了 1 处:实例临时目录从 Path.GetTempPath()
         改成 TestHome.Root(红线:测试临时文件必须落在仓库内),断言一字未改;
         LayoutDefaultTests.cs 一字未改。 -->
    <!-- C 类:依赖界面层命名空间(TipCL.Services / Pages / Controls / Themes),随 C 阶段对应页面恢复 -->
    <Compile Remove="Ported\AiChatOpsTests.cs" />          <!-- using TipCL.Pages.Ai → 恢复包 C3(AI 对话页) -->
    <!-- C2a(2026-11-13):Ported\FileKindsTests.cs 已恢复编译 —— C2a 把 FileKinds.cs 搬进
         src\TipCL.App\Services 了,这个文件现在能编。按 A6 的 B 类路径规则改了 2 处:
         两处 Path.GetTempPath() 改成 TestHome.Root(红线:测试临时文件必须落在仓库内),
         断言一字未改;改动逐条记在 PROGRESS.md 的 C2a 小节。 -->
    <!-- C2b(2026-11-13):Ported\NavCompatTests.cs 已恢复编译 —— NavModel / NavConfig / NavDef /
