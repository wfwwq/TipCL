         断言一字未改(文件本身未动)。 -->
    <Compile Remove="Ported\StaticInitOrderTests.cs" />    <!-- 读 src/TipCL/Pages/SettingsPage.cs 源码 → 恢复包 C3(设置页) -->
    <!-- C 类:Windows 专属,与界面层命名空间 + ImageSharp 绑定,mac 版不适用(GOAL:图片走 SkiaSharp) -->
